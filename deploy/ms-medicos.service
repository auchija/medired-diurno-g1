[Unit]
Description=Microservicio medicos - MediRed
After=network.target

[Service]
User=nodeapps
Group=nodeapps
WorkingDirectory=/srv/medired/publish/ms-medicos
ExecStart=/usr/bin/dotnet ms-medicos.dll
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=DOTNET_CLI_TELEMETRY_OPTOUT=1
Restart=on-failure

[Install]
WantedBy=multi-user.target
