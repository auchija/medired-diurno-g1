{
  "info": {
    "_postman_id": "e451498a-d295-41df-a288-a629e254d7bf",
    "name": "ms-historias",
    "description": "Casos de prueba del Taller 2 para ms-historias (puerto 3005). Ejecutar en orden: el caso 07 crea una historia nueva y los casos 10, 12 y 13 trabajan sobre ella, así la colección se puede repetir sin dañar los 3 registros iniciales. El caso 03 (consulta por lotes) no aplica: ningún servicio consulta historias.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base",
      "value": "http://127.0.0.1:3005"
    },
    {
      "key": "id_nuevo",
      "value": "4"
    }
  ],
  "item": [
    {
      "name": "01 · Listar todos → 200",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base}}/historias",
          "host": [
            "{{base}}"
          ],
          "path": [
            "historias"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Responde 200\", function () { pm.expect(pm.response.code).to.be.oneOf([200]); });",
              "pm.test(\"Devuelve al menos 3 historias\", function () { pm.expect(pm.response.json().length).to.be.at.least(3); });"
            ]
          }
        }
      ]
    },
    {
      "name": "02 · Filtrar por paciente → 200",
      "request": {
        "method": "GET",
        "header": [],
