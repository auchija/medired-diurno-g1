          "raw": "{{base}}/historias?paciente_id=1",
          "host": [
            "{{base}}"
          ],
          "path": [
            "historias"
          ],
          "query": [
            {
              "key": "paciente_id",
              "value": "1"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Responde 200\", function () { pm.expect(pm.response.code).to.be.oneOf([200]); });",
              "pm.test(\"Todas son del paciente 1\", function () { pm.response.json().forEach(function (h) { pm.expect(h.paciente_id).to.eql(1); }); });"
            ]
          }
        }
      ]
    },
