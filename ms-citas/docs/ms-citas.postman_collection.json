          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Responde 201\", function () { pm.expect(pm.response.code).to.be.oneOf([201]); });",
              "if (pm.response.code === 201) { pm.collectionVariables.set(\"cita_id\", pm.response.json().id); }"
            ]
          }
