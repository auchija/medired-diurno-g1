            "exec": [
              "// Fecha futura distinta en cada ejecución, para no chocar con citas anteriores (formato AAAA-MM-DDTHH:MM)",
              "const d = new Date(Date.UTC(2027, Math.floor(Math.random()*12), 1 + Math.floor(Math.random()*28), 7 + Math.floor(Math.random()*10), [0,15,30,45][Math.floor(Math.random()*4)]));",
              "pm.collectionVariables.set(\"fecha_nueva\", d.toISOString().slice(0, 16));"
            ]
          }
        },
