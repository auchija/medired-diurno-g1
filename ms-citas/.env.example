# Copie este archivo como .env y ajuste los valores.
# El archivo .env NO se sube al repositorio (está en .gitignore).

# Puerto donde escucha este microservicio.
# ms-citas usa el 3004 según la tabla de asignación del grupo.
PORT=3004
# 127.0.0.1 = solo acepta conexiones desde el mismo equipo (el gateway Apache estará en ese mismo equipo)
HOST=127.0.0.1

# Base de datos MySQL de este microservicio
DB_HOST=localhost
DB_PORT=3306
DB_NAME=citas_db
DB_USER=citas_user
DB_PASSWORD=una-clave-segura
# Direcciones de los microservicios que ms-citas consulta (en servidor2 serán las mismas: mismo equipo)
PACIENTES_URL=http://127.0.0.1:3002
MEDICOS_URL=http://127.0.0.1:3003